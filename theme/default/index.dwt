<!DOCTYPE html>
<html lang="zh-CN">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap.min.css" rel="stylesheet" type="text/css" />
 <link href="css/swiper.min.css" rel="stylesheet" type="text/css" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/style.css" rel="stylesheet" type="text/css" />
 <link href="css/index.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper">
  {include file="inc/header.tpl"}
  <div id="index">
   {include file="inc/slide_show.tpl"}
   {include file="inc/about.tpl"}

   <!-- {if $features.product} -->
   {include file="inc/recommend_product.tpl"}
   <!-- {/if} -->
   <!-- {if $features.article} -->
   {include file="inc/recommend_article.tpl"}
   <!-- {/if} -->
   <!-- {if $features.link} -->
   {include file="inc/link.tpl"}
   <!-- {/if} -->
  </div>
  {include file="inc/online_service.tpl"}
  {include file="inc/footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/bootstrap.min.js"></script>
 <script type="text/javascript" src="js/swiper.min.js"></script>
 <script type="text/javascript" src="js/slide.show.js"></script>
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
</body>

</html>