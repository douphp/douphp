<!DOCTYPE html>
<html lang="zh-CN">

<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="keywords" content="{$keywords}" />
 <meta name="description" content="{$description}" />
 <meta name="generator" content="{$generator}" />
 <meta name="csrf-token" content="{$csrf_token}">
 <title>{$page_title}</title>
 <link href="{$site.root_url}favicon.ico" rel="shortcut icon" type="image/x-icon" />
 <link href="css/bootstrap.min.css" rel="stylesheet" type="text/css" />
 <link href="css/bootstrap-icons.css" rel="stylesheet" type="text/css" />
 <!-- {if $editor_mode} -->
 <link href="css/jquery.notebook.min.css" rel="stylesheet" />
 <!-- {/if} -->
 <link href="css/common.css" rel="stylesheet" type="text/css" />
 <link href="css/style.css" rel="stylesheet" type="text/css" />
 <link href="css/content.css" rel="stylesheet" type="text/css" />
 {include file="inc/code_head.tpl"}
</head>

<body>
 <div id="wrapper"> {include file="inc/header.tpl"}
  <div class="container mb">
   <div class="row">
    <div class="col-md-2"> {include file="inc/page_tree.tpl"} </div>
    <div class="col-md-10"> {include file="inc/ur_here.tpl"}
     <div id="page">
      <h1>{$page.name}</h1>
      <div class="content{if $editor_mode} visualize-box{/if}"> {$page.content nofilter} </div>
     </div>
    </div>
   </div>
  </div>
  {include file="inc/online_service.tpl"}
  {include file="inc/footer.tpl"}
 </div>
 {include file="inc/code_footer.tpl"}
 <script type="text/javascript" src="js/bootstrap.min.js"></script>
 <script type="text/javascript" src="js/dou.js"></script>
 <script type="text/javascript" src="js/online_service.js"></script>
 <!-- {if $editor_mode} -->
 {include file="inc/jquery_notebook.tpl"}
 <!-- {/if} -->
</body>

</html>