/* components/navbar/navbar.wxss */
.navigation {
 position: fixed;
 width: 100%;
 z-index: 99;
 top: 0;
 left: 0;
}
.navigation .nav-bg {
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
}
.navigation .bar {
 position: relative;
 display: flex;
 flex-direction: row;
 align-items: center;
 box-sizing: border-box;
 /* 左右预留胶囊按钮区域，避免自定义内容顶到系统按钮 */
 padding-left: 15px;
 padding-right: 200rpx;
}
.navigation .bar-left {
 position: relative;
 z-index: 2;
 display: flex;
 flex-direction: row;
 align-items: center;
 flex-shrink: 0;
}
.navigation .bar-center {
 position: absolute;
 left: 174rpx;
 right: 200rpx;
 top: 0;
 bottom: 0;
 z-index: 1;
 display: flex;
 align-items: center;
 justify-content: center;
 overflow: hidden;
}
.navigation .bar-right {
 position: relative;
 z-index: 2;
 display: flex;
 flex-direction: row;
 align-items: center;
 justify-content: flex-end;
 flex: 1;
 min-width: 0;
}
.navigation .menu {
 display: flex;
 align-items: center;
 border: 1px solid #EEE;
 background-color: #FFF;
 border-radius: 10px;
 z-index: 10000;
}
.navigation .menu .item {
 display: flex;
 align-items: center;
 padding: 0 5px;
 border-right: 1px solid #EEE;
}
.navigation .menu .item:last-child {
 border-right: 0;
}
.navigation .title {
 width: 100%;
 text-align: center;
 font-size: 16px;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
}
.debug-layer {
 position: fixed;
 left: 0;
 right: 0;
 top: 0;
 bottom: 0;
 pointer-events: none;
 z-index: 99999;
}
.debug-layer .debug-dot {
 position: absolute;
 right: 10px;
 top: 50%;
 width: 24rpx;
 height: 24rpx;
 margin-top: -12rpx;
 border-radius: 50%;
 background-color: #E54D42;
 box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.3);
 pointer-events: auto;
}
