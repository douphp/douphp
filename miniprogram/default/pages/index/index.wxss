/* pages/index/index.wxss */
/* -- header：移植自 company/app.wxss，仅首页使用 -- */
.header {
  background-color: #fff;
}
.header .logo {
  box-sizing: content-box;
  height: 30px;
  text-align: center;
  padding: 15px 0;
}
.header .logo image {
  height: 100%;
}
.header .nav {
  white-space: nowrap;
  width: 100%;
  height: 50px;
  border-bottom: 1px solid #eee;
  font-size: 17px;
  color: #333;
}
.header .nav:scrollbar {
  height: 3px;
  color: #999;
}
.header .nav text {
  display: inline-block;
  padding: 8px 25px 8px 0;
}
.header .nav text.bi {
  padding-left: 20px;
  padding-right: 15px;
  font-size: 22px;
  color: #777;
}
.header .nav text.active {
  font-size: 22px;
  font-weight: bold;
}
.header .location {
  position: relative;
  border-bottom: 1px solid #eee;
  margin-bottom: 1px;
  height: 44px;
  z-index: 100;
}
.header .location .box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  background-color: #fff;
  transition: 0.3s all;
}
.header .location .box.fold {
  padding-right: 50px;
}
.header .location .head {
  height: 44px;
  line-height: 44px;
  border-bottom: 1px solid #eee;
  font-size: 13px;
  color: #000;
  font-weight: 700;
  padding-left: 20px;
  display: none;
}
.header .location .pop .head {
  display: block;
  margin-top: -1px;
  background-color: #fff;
}
.header .location .fold .menu {
  white-space: nowrap;
  width: 100%;
  color: #333;
  font-size: 13px;
}
.header .location .fold .menu text {
  display: inline-block;
  padding: 10px 15px;
  height: 43px;
}
.header .location .menu text:before {
  display: inline-block;
  font-family: bootstrap-icons !important;
  font-size: inherit;
  content: "\F3E7";
  color: #fff;
  margin-right: 4px;
}
.header .location .menu text.active {
  color: var(--color-primary);
}
.header .location .menu text.active:before {
  color: var(--color-primary);
}
.header .location .pop {
  animation-name: slideUp;
  animation-duration: 0.15s;
  animation-timing-function: ease-in-out;
}
@keyframes slideUp {
  0% {
    top: 20%;
    opacity: 0.3;
  }
  100% {
    top: 0%;
    opacity: 1;
  }
}
.header .location .pop .menu {
  width: 100%;
  color: #333;
  padding: 5px 0;
}
.header .location .pop .menu text {
  display: inline-block;
  width: 25%;
  text-align: center;
  padding: 5px 10px;
  font-size: 13px;
}
.header .location .more {
  position: absolute;
  right: 0;
  top: 0;
  width: 43px;
  height: 44px;
  line-height: 44px;
  margin-top: -1px;
  text-align: center;
  font-size: 20px;
  color: #999;
  box-shadow: -1px -1px 6px 0px rgb(0 0 0 / 6%);
  background-color: #fff;
}
/* -- inc-box：移植自 company/app.wxss，仅首页使用 -- */
.inc-box {
  margin-bottom: 5px;
  background-color: #fff;
  height: 100%;
}
.inc-box .head {
  font-size: 18px;
  color: #000;
  padding: 15px 0 8px 0;
}
.inc-box .head .more {
  float: right;
  font-size: 13px;
  color: var(--color-primary);
}
/* -- swiper -- */
/* 无幻灯片时 imgheight 为空，给兜底高度避免顶部塌陷 */
.swiper {
 min-height: 150px;
}
.swiper .slide {
 width: 100%;
}
/* -- 商品卡片价格 -- */
/* .grid-list 内价格会继承 13px，价格与标题同大难以区分，首页单独提升字号 */
.grid-list .item .price {
 font-size: 15px;
 font-weight: bold;
 line-height: 1.4;
}
.grid-list .item .price .price-line {
 margin-left: 4px;
 font-size: 12px;
 font-weight: normal;
}
.tree {
 background-color: #FFF;
}
.tree .dl {
 border-bottom: 1px solid #E4E4E4;
 padding-bottom: 5px;
}
.tree .dl .dt .a {
 display: block;
 padding: 10px 13px 7px 0;
 font-size: 14px;
}
/* 右侧箭头表示可进入该分类 */
.tree .dl .dt .a text {
 float: right;
 font-size: 11px;
 color: #ccc;
 margin-top: 3px;
}
.tree .dl .dd .a {
 display: block;
 padding: 5px 0;
 font-size: 14px;
 color: #999;
}
/* -- index-about -- */
.index-about .img image {
 width: 100%;
}
.index-about .text {
 margin-top: 10px;
 line-height: 200%;
 color: #777;
}
/* article-list
----------------------------------------------- */
.article-list {
 background-color: #FFF;
}
.article-list .item {
 border-top: solid #EEEEEE 1px;
 padding: 13px 0;
}
.article-list .title {
 margin-bottom: 5px;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
}
.article-list .info {
 color: #999999;
}
.article-list .info text {
 margin-right: 8px;
}
/* -- index-contact -- */
.index-contact {
 padding-bottom: 20px;
}
.index-contact .item {
 margin-bottom: 10px;
 position: relative;
 padding-left: 60px;
 border-top: 1px solid #EEE;
 padding-top: 10px;
}
.index-contact .item .bi {
 position: absolute;
 left: 0;
 top: 10px;
 border: 1px solid #DDD;
 color: #777;
 width: 46px;
 height: 46px;
 border-radius: 23px;
 text-align: center;
 line-height: 46px;
 font-size: 16px;
}
.index-contact .item .name {
 color: #999;
}
.index-contact .item .text {
 
}
