/* pages/aigc/app.wxss AI应用生成 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 24rpx 30rpx 40rpx;
}

.aigc-app-head {
  margin-bottom: 20rpx;
}
.aigc-app-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.aigc-app-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 配额 */
.aigc-quota {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f6f9ff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #4a5a70;
}
.aigc-quota-link {
  color: #4a90e2;
}

/* 表单 */
.aigc-form {
  background: #fff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  padding: 24rpx;
}
.aigc-field {
  margin-bottom: 28rpx;
}
.aigc-field-label {
  font-size: 28rpx;
  color: #3c4a5e;
  margin-bottom: 12rpx;
}
.aigc-required {
  color: #d9534f;
  margin-left: 6rpx;
}
.aigc-input,
.aigc-textarea,
.aigc-picker {
  width: 100%;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}
.aigc-textarea {
  min-height: 160rpx;
  line-height: 1.6;
}
.aigc-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.aigc-option {
  display: block;
  font-size: 26rpx;
  color: #4a5a70;
  padding: 12rpx 0;
}
.aigc-field-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa5b5;
}
.aigc-submit {
  margin-top: 10rpx;
  background: #4a90e2;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.aigc-submit[disabled] {
  background: #c6c9ce;
}

/* 结果 */
.aigc-result {
  margin-top: 30rpx;
}
.aigc-status {
  color: #4a90e2;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.aigc-error {
  color: #d9534f;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.aigc-files {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.aigc-image {
  width: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #eef1f6;
}
.aigc-video {
  width: 100%;
  border-radius: 12rpx;
}
.aigc-file-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #eef1f6;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #4a5a70;
}
.aigc-file-card .bi {
  font-size: 34rpx;
  color: #4a90e2;
}
.aigc-file-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.aigc-file-open {
  color: #4a90e2;
  flex-shrink: 0;
}
