/* pages/aigc/package.wxss AI套餐 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 20rpx 30rpx;
}

.aigc-quota-card {
  background: linear-gradient(135deg, #4a90e2, #357abd);
  border-radius: 16rpx;
  color: #fff;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.aigc-quota-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.aigc-quota-head .name {
  font-size: 32rpx;
  font-weight: bold;
}
.aigc-quota-head .expires {
  font-size: 24rpx;
  opacity: 0.85;
}
.aigc-quota-stats {
  display: flex;
}
.aigc-quota-stats .stat {
  flex: 1;
}
.aigc-quota-stats .label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.aigc-quota-stats .value {
  font-size: 34rpx;
  font-weight: bold;
}

.aigc-package {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.aigc-package-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.aigc-package-head .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.aigc-package-head .price {
  font-size: 36rpx;
  color: #fa541c;
  font-weight: bold;
}
.aigc-package-head .unit {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}
.aigc-package-features {
  padding: 20rpx 0;
}
.aigc-package-features .feature {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
}
.aigc-package-features .label {
  color: #999;
}
.aigc-package-features .value {
  color: #333;
}
.aigc-package-content {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 18rpx;
  font-size: 24rpx;
  color: #7b8798;
  line-height: 1.8;
}
.aigc-package-action {
  margin-top: 24rpx;
  background: #4a90e2;
  color: #fff;
  text-align: center;
  border-radius: 40rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
}
.aigc-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
