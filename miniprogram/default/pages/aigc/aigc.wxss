/* pages/aigc/aigc.wxss AI应用中心 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 20rpx 30rpx;
}

/* 顶部入口 */
.aigc-entries {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.aigc-entry {
  flex: 1;
  background: #fff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  padding: 26rpx 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4a5a70;
}
.aigc-entry text {
  display: block;
  font-size: 38rpx;
  color: #4a90e2;
  margin-bottom: 10rpx;
}

/* 应用列表 */
.aigc-app-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.aigc-app-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #eef4fd;
  color: #4a90e2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.aigc-app-icon image {
  width: 100%;
  height: 100%;
}
.aigc-app-info {
  flex: 1;
  min-width: 0;
}
.aigc-app-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.aigc-app-name .aigc-badge {
  display: inline-block;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  font-weight: normal;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.aigc-app-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.aigc-app-type {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #4a90e2;
}
.aigc-arrow {
  color: #ccc;
  margin-left: 16rpx;
}
.aigc-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
