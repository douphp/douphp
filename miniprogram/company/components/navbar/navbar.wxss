/* components/navbar/navbar.wxss */
.navigation {
 position: fixed;
 width: 100%;
 z-index: 99;
 top: 0;
 left: 0;
 background-color: #FFF;
}
.navigation .bar {
 position: relative;
 display: flex;
 flex-direction: row;
 align-items: center;
}
.navigation .menu {
 margin-left: 15rpx;
 display: flex;
 align-items: center;
 border: 1px solid #EEE;
 background-color: #FFF;
 border-radius: 10px;
 z-index: 10000;
}
.navigation .menu .item {
 display: flex;
 align-items: center;
 padding: 0 5px;
 border-right: 1px solid #EEE;
}
.navigation .menu .item:last-child {
 border-right: 0;
}
.navigation .title {
 position: absolute;
 left: 174rpx;
 right: 174rpx;
 text-align: center;
 font-size: 16px;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
}
.debug-layer {
 position: fixed;
 left: 0;
 right: 0;
 top: 0;
 bottom: 0;
 pointer-events: none;
 z-index: 99999;
}
.debug-layer .debug-dot {
 position: absolute;
 right: 10px;
 top: 50%;
 width: 24rpx;
 height: 24rpx;
 margin-top: -12rpx;
 border-radius: 50%;
 background-color: #E54D42;
 box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.3);
 pointer-events: auto;
}