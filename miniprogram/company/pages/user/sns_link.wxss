.snsLink {
 padding: 30px 10px;
 background-color: #FFF;
 text-align: center;
}
.snsLink .head {
 font-size: 22px;
 font-weight: bold;
 margin-bottom:40px;
}
.snsLink .img .image {
 width: 100px;
 height: 100px;
 border: 1px solid #e0e0e0;
 border-radius: 100px;
}
.snsLink .action {
 margin-top: 40px;
}
.snsLink .action .btn {
 margin-bottom: 10px;
}
