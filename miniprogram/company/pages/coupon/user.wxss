/* pages/coupon/user.wxss */
.coupon-list {
 margin: 0 -10px;
 display: flex;
 flex-wrap: wrap;
 justify-content: flex-start;
}
.coupon-list .item-box {
 width: 50%;
}
.coupon-list .item {
 border: 1px solid #EEE;
 margin: 10px;
}
.coupon-list .item .head {
 background-color: #81D2D5;
 text-align: center;
 padding: 30px 10px 20px 10px;
 color: #FFF;
 position: relative;
}
.coupon-list .item .head .circle {
 width: 40px;
 height: 40px;
 border-radius: 20px;
 background-color: #FFF;
 position: absolute;
 left: 50%;
 top: 0;
 margin-top: -25px;
 margin-left: -20px;
}
.coupon-list .item .head .money {
 font-size: 28px;
 margin-bottom: 15px;
}
.coupon-list .item .head .name {
 margin-bottom: 25px;
}
.coupon-list .item .head .time {
 color: #197f81;
}
.coupon-list .item .body {
 padding: 20px 15px 20px 15px;
}
.coupon-list .item .body .row {
 margin-bottom: 10px;
 color: #999;
}
.coupon-list .item .body .row .b {
 color: #555;
}
.coupon-list .item .body .row .i {
 color: #81D2D5;
}
