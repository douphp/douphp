/* pages/book/user.wxss */
.book-list {
}
.book-list .item {
 margin-bottom: 20px;
 overflow: hidden;
 transition: all 0.3s ease;
 border: 1px solid #f0f0f0;
 background: #fafafa;
 border-radius: 6px;
}
.book-list .item .item-link {
 display: block;
 text-decoration: none;
 color: inherit;
 transition: all 0.3s ease;
}
.book-list .item .item-link:active {
 background-color: #f5f5f5;
}
.book-list .item .head {
 padding: 10px 8px 10px 16px;
 border-bottom: 1px solid #EEE;
 display: flex;
 justify-content: space-between;
 align-items: center;
 position: relative;
}
.book-list .item .head::before {
 position: absolute;
 left: 0;
 top: 50%;
 transform: translateY(-50%);
 content: "";
 display: inline-block;
 width: 4px;
 height: 16px;
 background-color: #19B4EA;
 border-radius: 2px;
 margin-right: 8px;
}
.book-list .item .head .time {
 font-weight: bold;
 color: #333;
 font-size: 15px;
}
.book-list .item .head .status {
 display: inline-block;
 color: #999;
 font-size: 13px;
}
.book-list .item .body {
 padding: 10px 16px;
 display: flex;
 flex-direction: column;
 gap: 10px;
}
.book-list .item .info {
 color: #555;
 display: flex;
 align-items: flex-start;
 font-size: 14px;
}
.book-list .item .info:last-child {
 margin-bottom: 0;
 padding-bottom: 0;
 border-bottom: none;
}
.book-list .item .info text {
 display: inline-block;
 min-width: 80px;
 color: #999;
 font-weight: 500;
 flex-shrink: 0;
}
.book-list .item .info .value {
 color: #333;
 flex: 1;
}
.loadpage, .nomore {
 text-align: center;
 padding: 20px;
 color: #999;
 font-size: 14px;
}