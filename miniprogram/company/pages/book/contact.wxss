/* pages/book/contact.wxss */
.contact-select {
 margin-top: 20px;
 padding-bottom: 50px;
}
.contact-select .box {
 margin-bottom: 20px;
 border: 1px solid #EEE;
 padding: 20px;
}
.contact-select .box .item {
 display: flex;
 justify-content: space-between;
 align-items: center;
 margin-bottom: 10px;
 border-bottom: 1px solid #EEE;
 padding-bottom: 10px;
}
.contact-select .box .item:last-child {
 margin-bottom: 0;
 border-bottom: 0;
 padding-bottom: 0;
}
.contact-select .box .item .name {
 font-weight: bold;
}
.contact-select .box .item .name text {
 font-size: 18px;
 width: 15px;
 text-align: center;
 margin-right: 5px;
}
.contact-select .box .item .value text {
 font-size: 12px;
 display: inline-block;
 border: 1px solid #19B4EA;
 color: #19B4EA;
 border-radius: 4px;
 line-height: 100%;
 padding: 2px 5px;
 cursor: pointer;
}
/* -- remark-box -- */
.remark-box {
  margin-bottom: 20px;
  padding: 20px;
  border: 1px solid #EEE;
}
.remark-box .remark-head {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
}
.remark-box .text-area {
  border: none;
  background-color: #f9f7f7;
  padding: 10px;
}
/* -- contact-box -- */
.contact-box .overlay {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background-color: rgba(0, 0, 0, 0.5);
 z-index: 10001;
}
.contact-box .popup {
 position: fixed;
 bottom: -100%; /* 初始位置在屏幕外 */
 left: 0;
 width: 100%;
 background-color: white;
 z-index: 10002; /* 在遮罩层之上 */
 transition: bottom 0.3s ease-out;
}
.contact-box .popup.active {
 bottom: 0; /* 弹出到屏幕底部 */
}
.contact-box .head {
 font-size: 16px;
 font-weight: bold;
 padding: 15px 25px 0 25px;
}
.contact-box .head .bi {
 float: right;
 font-size: 20px;
 cursor: pointer;
}
.contact-box .list {
 padding: 10px;
 max-height: 60vh;
 overflow: auto;
}
.contact-box .list .item {
 padding: 15px;
 cursor: pointer;
}
.contact-box .list .item text {
 font-size: 20px;
 margin-right: 10px;
}
.contact-box .list .item.active {
 border: 1px solid #19B4EA;
 color: #19B4EA;
}
.contact-box .list .item.active text {
 color: #19B4EA;
}
/* -- custom-fields-box -- */
.custom-fields-box .custom-field {
 margin-bottom: 12px;
 padding-bottom: 12px;
 border-bottom: 1px solid #eee;
}
.custom-fields-box .custom-field:last-child {
 margin-bottom: 0;
 padding-bottom: 0;
 border-bottom: 0;
}
.custom-fields-box .custom-field .label {
 font-weight: bold;
 margin-bottom: 6px;
}
.custom-fields-box .custom-field .label .required {
 color: #d9534f;
 margin-left: 4px;
}
.custom-fields-box .custom-field .value .custom-input,
.custom-fields-box .custom-field .value .custom-textarea {
 width: 100%;
 box-sizing: border-box;
 background-color: #f9f7f7;
 padding: 8px 10px;
 border-radius: 4px;
}
.custom-fields-box .custom-field .picker {
 padding: 8px 10px;
 background-color: #f9f7f7;
 border-radius: 4px;
}
.custom-fields-box .custom-field .custom-radio-group .radio-item {
 display: inline-block;
 margin-right: 18px;
 margin-bottom: 6px;
}

/* -- submit-box -- */
.contact-select .submit-box .btn {
 width: 100%;
 height: 45px;
 line-height: 45px;
 text-align: center;
 background-color: #19B4EA;
 color: #fff;
 font-size: 16px;
 border-radius: 5px;
 cursor: pointer;
 margin-top: 20px;
}