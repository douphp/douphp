/* pages/book/list.wxss */
.wrap {
 padding: 0 12px;
}
.item-list {
 margin-top: 10px;
}
.item-list .item {
 display: flex;
 border: 1px solid #EEE;
 margin-bottom: 12px;
 padding: 12px;
}
.item-list .item .img image {
 width: 80px;
}
.item-list .item .info {
 padding: 0 8px;
}
.item-list .item .info .name {
 font-size: 16px;
 font-weight: bold;
}
.item-list .item .info .tag {
 display: inline-block;
 font-size: 12px;
 border: 1px solid #DDD;
 color: #555;
 line-height: 100%;
 padding: 2px 8px;
 margin-bottom: 4px;
}
.item-list .item .info .brief {
 color: #999;
 font-size: 12px;
 line-height: 1.4;
}
/* -- view-toggle -- */
.view-toggle {
 display: flex;
 margin: 12px 0 8px 0;
}
.view-toggle .btn {
 flex: 1;
 text-align: center;
 padding: 10px 0;
 border: 1px solid #DDD;
 font-size: 13px;
 color: #555;
 background: #FFF;
}
.view-toggle .btn:first-child {
 border-radius: 4px 0 0 4px;
}
.view-toggle .btn:last-child {
 border-radius: 0 4px 4px 0;
 border-left: none;
}
.view-toggle .btn.active {
 background: #19B4EA;
 color: #FFF;
 border-color: #19B4EA;
}
/* -- schedule-date-list -- */
.schedule-date-list {
 overflow-x: auto;
 white-space: nowrap;
 margin: 8px 0;
}
.schedule-date-list .item {
 display: inline-block;
 border: 1px solid #EEE;
 padding: 8px 14px;
 text-align: center;
 margin-right: 8px;
}
.schedule-date-list .item.active {
 border-color: #19B4EA;
 color: #19B4EA;
 background: #F0FBFF;
}
.schedule-date-list .item .date {
 font-size: 13px;
 font-weight: bold;
}
.schedule-date-list .item .week {
 font-size: 11px;
 color: #999;
 margin-top: 2px;
}
/* -- schedule-list -- */
.schedule-list {
 margin-top: 6px;
}
.schedule-list .doctor-card {
 border: 1px solid #EEE;
 border-radius: 6px;
 padding: 12px;
 margin-bottom: 10px;
}
.schedule-list .doctor-card .doctor-info {
 display: flex;
 align-items: flex-start;
 gap: 8px;
 margin-bottom: 8px;
}
.schedule-list .doctor-card .doctor-info .img image {
 width: 80px;
 flex-shrink: 0;
}
.schedule-list .doctor-card .doctor-meta .doctor-name {
 font-size: 16px;
 font-weight: bold;
 color: #333;
}
.schedule-list .doctor-card .doctor-meta .doctor-tag {
 font-size: 12px;
 color: #999;
 margin-top: 2px;
}
.schedule-list .doctor-card .doctor-meta .doctor-brief {
 color: #999;
 font-size: 12px;
 margin-top: 2px;
 line-height: 1.4;
}
.schedule-list .doctor-card .session-row {
 display: flex;
 gap: 6px;
}
.schedule-list .doctor-card .session {
 flex: 1;
 border: 1px solid #EEE;
 border-radius: 4px;
 padding: 8px 0;
 text-align: center;
}
.schedule-list .doctor-card .session.disabled {
 background: #F8F8F8;
}
.schedule-list .doctor-card .session .session-label {
 font-size: 12px;
 color: #666;
 margin-bottom: 2px;
}
.schedule-list .doctor-card .session .session-count {
 font-size: 13px;
 font-weight: bold;
 color: #19B4EA;
}
.schedule-list .doctor-card .session.disabled .session-count {
 color: #CCC;
}
.schedule-list .schedule-empty {
 text-align: center;
 color: #999;
 padding: 36px 0;
 font-size: 13px;
}
/* -- time-panel (底部弹出面板) -- */
.time-panel-overlay {
 position: fixed;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 background-color: rgba(0, 0, 0, 0.5);
 z-index: 1000;
}
.time-panel {
 position: fixed;
 bottom: -100%;
 left: 0;
 width: 100%;
 background-color: #FFF;
 z-index: 1001;
 transition: bottom 0.3s ease-out;
 max-height: 80%;
 border-radius: 16px 16px 0 0;
 box-shadow: 0 -2px 20px rgba(0,0,0,0.1);
}
.time-panel.active {
 bottom: 0;
}
.time-panel .time-panel-head {
 display: flex;
 justify-content: space-between;
 align-items: center;
 padding: 16px 16px 10px 16px;
 font-size: 15px;
 font-weight: bold;
 border-bottom: 1px solid #EEE;
}
.time-panel .time-panel-head .close-btn {
 font-size: 18px;
 color: #999;
}
.time-panel .time-list {
 display: flex;
 flex-wrap: wrap;
 padding: 12px;
 gap: 8px;
 overflow-y: auto;
 max-height: 50vh;
}
.time-panel .time-list .item {
 width: calc(33.3% - 6px);
 border: 1px solid #EEE;
 padding: 10px 0;
 text-align: center;
 border-radius: 4px;
}
.time-panel .time-list .item .label {
 font-size: 12px;
 color: #333;
}
.time-panel .time-list .item .remaining {
 display: block;
 color: #999;
 font-size: 11px;
 margin-top: 2px;
}
.time-panel .time-list .item .price {
 display: block;
 color: #999;
 font-size: 11px;
}
.time-panel .time-list .item.active {
 background: #19B4EA;
 border-color: #19B4EA;
 color: #FFF;
}
.time-panel .time-list .item.active .label,
.time-panel .time-list .item.active .remaining,
.time-panel .time-list .item.active .price {
 color: #FFF;
}
.time-panel .time-list .item.booked,
.time-panel .time-list .item.full,
.time-panel .time-list .item.disabled {
 background: #F5F5F5;
 color: #AAA;
}
.time-panel .time-panel-submit {
 padding: 10px 12px 20px 12px;
}
.time-panel .time-panel-submit .btn {
 width: 100%;
 background: #19B4EA;
 color: #FFF;
 border-radius: 6px;
 font-size: 14px;
}
