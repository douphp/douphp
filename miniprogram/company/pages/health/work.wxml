<!--pages/health/work.wxml-->
<navbar title="{{title}}" url="/pages/work/work"></navbar>
<view class="body">
 <view class="navbar" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
  <view class="wrap">
   <scroll-view class="navScroll" scroll-x="true" scroll-with-animation="true" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
    <view class="item{{item.value == status ? ' active' : ''}}" wx:for="{{status_list}}" wx:key="value" wx:for-item="item" data-status="{{item.value}}" bindtap="douMenu">{{item.format}}</view>
   </scroll-view>
  </view>
 </view>
 <view class="navbar-space"></view>
 <view class="healthList">
  <view class="item" wx:for="{{health_list}}" wx:for-item="health" wx:key="id" data-url="/pages/health/show?is_work=1&id={{health.id}}" bindtap="douNavigateTo">
   <view class="name">
    <block wx:if="{{health.name}}">{{health.name}}</block>
    <block wx:else>{{health.health_sn}}</block>
    <text class="text">（{{health.status.format}}）</text>
   </view>
   <view class="meta">
    <em>{{lang.health_health_sn}}：</em>{{health.health_sn}}
    <text style="margin-left:10px;"><em>{{lang.health_add_time}}：</em>{{health.created_at}}</text>
   </view>
  </view>
 </view>
 <view class="loadpage" wx:if="{{loadpage}}">{{lang.loadpage}}</view>
</view>
