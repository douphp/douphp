<!--item_category.wxml-->
<navbar title="{{title}}"></navbar>
<view class="body">
 <view class="navbar" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
  <view class="wrap">
   <scroll-view class="navScroll" scroll-x="true" scroll-left="{{scrollLeft}}" scroll-with-animation="true" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
    <view class="item{{tree.cur == true ? ' active' : ''}}" wx:for="{{item_category}}" wx:key="index" wx:for-item="tree" data-catid="{{tree.id}}" data-index="{{index}}" bindtap="douMenu">{{tree.name}}</view>
   </scroll-view>
  </view>
 </view>
 <view class="navbar-space"></view>
 
 <view class="wrap">
  <view class="text-list" wx:if="{{cate_info.type == 'text'}}">
   <navigator class="item" hover-class="mouseDown" wx:for="{{item_list}}" wx:key="index" wx:for-item="item" url="{{item.url}}">
    <view class="con{{item.image ? '' : ' no-img'}}">
     <view class="title">{{item.title}}</view>
     <view class="info">
      <text>{{lang.item_size}}：{{item.size}}</text>
      <text>{{lang.click}}：{{item.click}}</text>
     </view>
    </view>
    <view class="img" wx:if="{{item.image}}">
     <image src="{{item.image}}" mode="widthFix" />
    </view>
   </navigator>
   <view class="loadpage" wx:if="{{loadpage}}">{{lang.loadpage}}</view>
  </view>
  <view class="grid-list" wx:else>
   <navigator class="item" hover-class="mouseDown" wx:for="{{item_list}}" wx:key="i" wx:for-item="item" url="{{item.url}}">
    <view class="img">
     <image src="{{item.image}}" mode="widthFix" style="height: 183px" />
    </view>
    <view class="title">{{item.title}}</view>
   </navigator>
   <view class="loadpage" wx:if="{{loadpage}}">{{lang.loadpage}}</view>
  </view>
 </view>
</view>