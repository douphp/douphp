/* pages/vip/vip.wxss */
/* -- package-cart -- */
.package-cart {
 background-color: #FAE8AE;
 height: 250px;
}
.package-cart .item {
 background-color: #FEF8E3;
 color: #000;
 margin: 20px 10px;
 border-radius: 12px;
 position: relative;
 overflow: hidden;
 height: 200px;
}
.package-cart .item .name {
 position: absolute;
 left: 20px;
 top: 20px;
 font-size: 28px;
 font-weight: bold;
 padding-right: 150px;
}
.package-cart .item .icon {
 position: absolute;
 right: -110px;
 top: -180px;
 font-size: 300px;
}
.package-cart .item .info {
 position: absolute;
 left: 20px;
 bottom: 20px;
}
.package-cart .item .info .price {
 font-weight: bold;
 font-size: 30px;
 color: #000;
}
.package-cart .item .info .price-original {
 text-decoration: line-through;
 color: #555;
 margin-left: 5px;
}
.package-cart .item .info .brief {
 font-size: 12px;
 color: #999;
}
.package-cart .item .action {
 position: absolute;
 right: 20px;
 bottom: 20px;
 background-color: #000;
 padding: 0 20px;
 line-height: 36px;
 border-radius: 18px;
 color: #FFF;
}
/* -- package-info -- */
.package-info {
 margin-top: 20px;
 display: flex;
 flex-wrap: wrap;
 justify-content: space-between;
}
.package-info .column {
}
.package-info .column:nth-child(1) {
 width: calc(60%);
}
.package-info .column:nth-child(2) {
 width: calc(40%);
}
.package-info .column .item, .package-info .column .head {
	border-bottom: 1px solid #EEE;
	text-align: center;
 padding: 10px;
}