/* pages/sn/sn.wxss */
#sn {
}
#sn .search-box {
 padding: 20px 0;
 box-sizing: border-box;
 display: flex;
 align-items: center;
 justify-content: space-between;
}
#sn .search-box .code-box {
 flex: 1;
 display: flex;
 align-items: center;
 line-height: 40px;
 height: 40px;
 padding: 0 15px;
 background-color: #F2F2F2;
 margin-right: 10px;
}
#sn .search-box .code-box .fa-search {
 font-size: 16px;
 margin-right: 10px;
 color: #999999;
}
#sn .search-box .code-box .code {
 width: 100%;
}
#sn .search-box .btn-search {
 width: 100px;
 height: 40px;
 line-height: 40px;
 border-radius: 0;
 -webkit-appearance: none;
 font-size: 14px;
 background-color: #000;
 color: #FFF;
}
#sn .head {
 font-weight: bold;
 color: #333333;
 display: flex;
 justify-content: space-between;
 padding-right: 15px;
 margin-bottom: 20px;
 border-bottom: 1px solid #EEE;
 padding-bottom: 15px;
}
#sn .head .del {
 color: #999999;
 font-weight: normal;
}