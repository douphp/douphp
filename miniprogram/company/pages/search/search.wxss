.page-search {
}
.page-search .search-bar .bar-form {
 padding: 20px 0;
 box-sizing: border-box;
 display: flex;
 align-items: center;
 justify-content: space-between;
}
.page-search .search-bar .bar-form .keyword-box {
 flex: 1;
 display: flex;
 align-items: center;
 line-height: 36px;
 height: 36px;
 padding: 0 15px;
 background-color: #F2F2F2;
 border-radius: 20px;
 margin-right: 10px;
}
.page-search .search-bar .bar-form .keyword-box .bi {
 font-size: 16px;
 margin-right: 10px;
 color: #999999;
}
.page-search .search-bar .bar-form .keyword-box .keyword {
 width: 100%;
}
.page-search .search-bar .bar-form .btn-search {
 width: 70px;
 height: 36px;
 line-height: 36px;
 font-size: 14px;
 border-radius: 20px;
 background-color: #000000;
 color: #FFF;
}
.page-search .search-bar .bar-head {
 font-size: 14px;
 font-weight: bold;
 color: #333333;
 display: flex;
 justify-content: space-between;
 padding-right: 15px;
}
.page-search .search-bar .bar-head .del {
 color: #999999;
 font-weight: normal;
}
.page-search .history-list {
}
.page-search .history-list .item {
 display: inline-block;
 padding: 0 20px;
 line-height: 30px;
 background-color: #EEE;
 border-radius: 15px;
 font-size: 12px;
 margin: 10px 10px 0 0;
}