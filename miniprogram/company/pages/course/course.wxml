<!--course.wxml-->
<navbar title="{{title}}"></navbar>
<view class="body">
 <view class="wrap">
  <view class="detail">
   <view class="title">{{course.title}}</view>
   <view class="info"><text>{{lang.created_at}}：{{course.created_at}}</text><text>{{lang.click}}：{{course.click}}</text>
    <text wx:for="{{defined}}" wx:key="index" wx:for-item="defined"> {{defined.arr}}：{{defined.value}} </text>
   </view>
   <view class="content">
    <mp-html content="{{course.content}}" />
   </view>
  </view>
 </view>
</view>