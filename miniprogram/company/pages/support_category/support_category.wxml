<!--support_category.wxml-->
<navbar title="{{title}}"></navbar>
<view class="body">
 <view class="navbar" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
  <view class="wrap">
   <scroll-view class="navScroll" scroll-x="true" scroll-left="{{scrollLeft}}" scroll-with-animation="true" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
    <view class="item{{tree.cur == true ? ' active' : ''}}" wx:for="{{support_category}}" wx:key="index" wx:for-item="tree" data-catid="{{tree.id}}" data-index="{{index}}" bindtap="douMenu">{{tree.name}}</view>
   </scroll-view>
  </view>
 </view>
 <view class="navbar-space"></view>
 
 <view class="wrap">
  <view class="text-list">
   <navigator class="item{{support.image ? '' : ' no-img'}}" hover-class="mouseDown" wx:for="{{support_list}}" wx:key="index" wx:for-item="support" url="{{support.url}}">
    <view class="con">
     <view class="title">{{support.title}}</view>
     <view class="info">
      <text>{{lang.created_at}}：{{support.created_at}}</text>
      <text>{{lang.click}}：{{support.click}}</text>
     </view>
    </view>
    <view class="img" wx:if="{{support.image}}">
     <image src="{{support.image}}" mode="widthFix" />
    </view>
   </navigator>
   <view class="loadpage" wx:if="{{loadpage}}">{{lang.loadpage}}</view>
  </view>
 </view>
</view>