<!--pages/store/store.wxml-->
<navbar title="{{title}}"></navbar>
<view class="body">
 <view class="navbar" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
  <view class="wrap">
   <scroll-view class="navScroll" scroll-x="true" scroll-left="{{scrollLeft}}" scroll-with-animation="true" style="{{'top: ' + navigationBarAndStatusBarHeight}}">
    <view class="item{{!class ? ' active' : ''}}" bindtap="douAll">{{lang.all}}</view>
    <view class="item{{item.cur ? ' active' : ''}}" wx:for="{{class_list}}" wx:key="index" wx:for-item="item" data-class="{{item.name}}" data-index="{{index}}" bindtap="douMenu">{{item.name}}</view>
   </scroll-view>
  </view>
 </view>
 <view class="navbar-space"></view>
 
 <view class="wrap">
  <view class="grid-list left">
   <navigator class="item" hover-class="mouseDown" wx:for="{{store_list}}" wx:key="i" wx:for-item="store" url="{{store.url}}">
    <view class="img">
     <image src="{{store.image}}" mode="widthFix" style="height: 183px" />
    </view>
    <view class="title">{{store.name}}</view>
    <view class="desc">{{lang.store_address}}：{{store.address}}</view>
    <view class="desc">{{lang.store_telphone}}：{{store.telphone}}</view>
   </navigator>
   <view class="loadpage" wx:if="{{loadpage}}">{{lang.loadpage}}</view>
  </view>
 </view>
</view>