/* pages/order/show.wxss */
.order .table-basic {
 margin-bottom:8px;
}
.order .totalAmount {
 font-size: 13px;
 padding: 5px 10px;
 background-color: #FFF;
 margin-bottom:10px;
}
.order .totalAmount .dl {
 zoom:1;
 overflow:hidden;
 padding:3px 0;
}
.order .totalAmount .dt {
 float:left;
 color:#999;
}
.order .totalAmount .dd {
 float:right;
}
.order .totalAmount .payment {
 border-top: solid #EEE 1px;
 margin-top:10px;
 padding:10px 0;
 text-align:right;
}
.order .info {
 color:#999;
}
.order .btnBox {
 float: right;
}
.order .btnBox text {
 margin-left: 5px;
}
.order .itemList .h3 {
 padding: 8px 10px;
 background-color: #FFF;
}
.order .itemList {
 background-color:#FFF;
}
.order .itemList .dl {
 zoom:1;
 overflow:hidden;
 background-color:#F8F8F8;
 padding:10px 10px;
 margin-bottom:3px;
}
.order .itemList .dl .dt {
 width:60px;
 float:left;
 margin-right:10px;
 line-height:38px;
}
.order .itemList .dl .dt image {
 width:60px;
 height:60px;
}
.order .itemList .dl.no-img .dd {
 margin-left:0;
}
.order .itemList .dl .dd .p {
 float:left;
 width:60%;
 font-weight:bold;
}
.order .itemList .dl .dd .span {
 float:right;
 text-align:right;
 color:#888;
}
/* pay-check & tracking
----------------------------------------------- */
.order .h3 {
 padding: 8px 10px;
 font-size: 13px;
 font-weight: bold;
 background-color: #FFF;
 border-bottom: 1px solid #EEE;
}
.order .pay-evidence-img {
 width: 200px;
 height: 150px;
 display: block;
}
.order .picker {
 color: #333;
 font-size: 13px;
}
.order .btn {
 display: inline-block;
 background-color: #28B779;
 color: #FFF;
 font-size: 13px;
 padding: 6px 16px;
 border-radius: 3px;
}
.order .input {
 border: 1px solid #DDD;
 border-radius: 3px;
 padding: 5px 8px;
 font-size: 13px;
 width: 100%;
 box-sizing: border-box;
}