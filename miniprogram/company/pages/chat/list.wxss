/* pages/chat/list.wxss AI助手应用中心 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 20rpx 30rpx;
}

/* 配额状态卡片 */
.chat-quota-card {
  background: linear-gradient(135deg, #4a90e2, #357abd);
  border-radius: 16rpx;
  color: #fff;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.chat-quota-card .quota-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.chat-quota-card .quota-header .name {
  font-size: 32rpx;
  font-weight: bold;
}
.chat-quota-card .quota-header .expires {
  font-size: 24rpx;
  opacity: 0.85;
}
.chat-quota-card .quota-stats {
  display: flex;
}
.chat-quota-card .stat {
  flex: 1;
}
.chat-quota-card .stat .label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.chat-quota-card .stat .value {
  font-size: 34rpx;
  font-weight: bold;
}

/* 无订阅提示 */
.chat-no-subscription {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 26rpx;
  color: #8c6d1f;
}
.chat-no-subscription .btn-buy {
  background: #fa8c16;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 应用列表 */
.chat-app-list .app-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.chat-app-list .app-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #eef4fd;
  color: #4a90e2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.chat-app-list .app-icon image {
  width: 100%;
  height: 100%;
}
.chat-app-list .app-info {
  flex: 1;
  min-width: 0;
}
.chat-app-list .app-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.chat-app-list .app-name .badge {
  display: inline-block;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  font-weight: normal;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.chat-app-list .app-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.chat-app-list .arrow {
  color: #ccc;
  margin-left: 16rpx;
}

.chat-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
