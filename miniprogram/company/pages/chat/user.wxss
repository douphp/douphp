/* pages/chat/user.wxss 我的AI订阅 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 20rpx 30rpx;
}

/* 配额状态卡片（与应用中心同款） */
.chat-quota-card {
  background: linear-gradient(135deg, #4a90e2, #357abd);
  border-radius: 16rpx;
  color: #fff;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.chat-quota-card .quota-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.chat-quota-card .quota-header .name {
  font-size: 32rpx;
  font-weight: bold;
}
.chat-quota-card .quota-header .expires {
  font-size: 24rpx;
  opacity: 0.85;
}
.chat-quota-card .quota-stats {
  display: flex;
}
.chat-quota-card .stat {
  flex: 1;
}
.chat-quota-card .stat .label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.chat-quota-card .stat .value {
  font-size: 34rpx;
  font-weight: bold;
}

.chat-no-subscription {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #8c6d1f;
}
.chat-no-subscription .btn-buy {
  background: #fa8c16;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.quick-actions {
  display: flex;
  margin-bottom: 24rpx;
}
.quick-actions .action {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: #4a90e2;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.quick-actions .action:last-child {
  margin-right: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 10rpx 0 20rpx;
}

.subscription-list .sub-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.subscription-list .sub-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.subscription-list .sub-header .name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.subscription-list .sub-header .status {
  font-size: 24rpx;
  color: #999;
}
.subscription-list .sub-header .status.active {
  color: #52c41a;
}
.subscription-list .sub-header .status.expired {
  color: #bbb;
}
.subscription-list .sub-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  padding: 8rpx 0;
}
.subscription-list .sub-row .label {
  color: #999;
}

.chat-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.loadpage {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}
