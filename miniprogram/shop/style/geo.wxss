/* GEO 模块共享样式（页面级 @import） */

.geo-page {
  min-height: 100vh;
  background: #f5f7fa;
}

.geo-section {
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.geo-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.geo-section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-primary);
}

.geo-card {
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.geo-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.geo-card-head .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.geo-kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #555;
}

.geo-kv em {
  font-style: normal;
  color: #888;
}

.geo-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #666;
  font-size: 22rpx;
}

.geo-tag-ok {
  background: #e8f7ee;
  color: #18a058;
}

.geo-tag-bad {
  background: #fdecec;
  color: #d03050;
}

.geo-tag-warn {
  background: #fff4e5;
  color: #d97706;
}

.geo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.geo-grid .item {
  width: calc(33.333% - 20rpx);
  margin: 10rpx;
  padding: 24rpx 8rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.geo-grid .item .bi {
  display: block;
  margin-bottom: 8rpx;
  font-size: 40rpx;
  color: var(--color-primary);
}

.geo-quota {
  padding: 14rpx 0;
}

.geo-quota-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #555;
}

.geo-quota-bar {
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  overflow: hidden;
}

.geo-quota-bar .fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.geo-stats {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.geo-stats .item {
  width: calc(33.333% - 16rpx);
  margin: 8rpx;
  padding: 18rpx 8rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.geo-stats .item b {
  display: block;
  font-size: 34rpx;
  color: var(--color-primary);
}

.geo-stats .item span {
  font-size: 22rpx;
  color: #888;
}

.geo-list .item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.geo-list .item:last-child {
  border-bottom: none;
}

.geo-list .title {
  font-size: 28rpx;
  color: #222;
  word-break: break-all;
}

.geo-list .meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
  word-break: break-all;
}

.geo-list .actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.geo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 12rpx 0 0;
  padding: 0 24rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f0f4fa;
  color: var(--color-primary);
  font-size: 24rpx;
}

.geo-btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.geo-btn-danger {
  background: #fdecec;
  color: #d03050;
}

.geo-btn-block {
  display: flex;
  width: 100%;
  height: 80rpx;
  margin: 20rpx 0 0;
  font-size: 28rpx;
}

.geo-form .row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.geo-form .label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: #666;
}

.geo-form .label .req {
  color: #d03050;
}

.geo-input,
.geo-textarea,
.geo-picker {
  width: 100%;
  padding: 16rpx 18rpx;
  border: 1rpx solid #e3e7ed;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #222;
  background: #fff;
}

.geo-textarea {
  height: 220rpx;
}

.geo-textarea-lg {
  height: 420rpx;
}

.geo-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333;
}

.geo-picker .placeholder {
  color: #aaa;
}

.geo-check {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.geo-check .item {
  margin: 6rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #e3e7ed;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #555;
  background: #fff;
}

.geo-check .item.on {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: #eef6ff;
}

.geo-check .item.disabled {
  opacity: 0.4;
}

.geo-tabs {
  display: flex;
  padding: 0 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f2f5;
}

.geo-tabs .tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #666;
}

.geo-tabs .tab.on {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}

.geo-empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.geo-empty .geo-btn {
  margin-top: 28rpx;
}

.geo-cue {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.geo-warn {
  color: #d97706;
  font-style: normal;
}

.geo-danger {
  color: #d03050;
}

.geo-copy {
  color: var(--color-primary);
  font-size: 23rpx;
  word-break: break-all;
}

.geo-image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.geo-image-grid .item {
  position: relative;
  width: calc(33.333% - 16rpx);
  margin: 8rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f2f4f7;
}

.geo-image-grid .item image {
  width: 100%;
  height: 180rpx;
  display: block;
}

.geo-image-grid .item .del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.geo-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
}

.geo-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: 85vh;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-sizing: border-box;
  overflow-y: auto;
}

.geo-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.geo-modal-head .close {
  padding: 8rpx 12rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: 400;
}

.geo-progress {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
}

.geo-progress .ring {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 20rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: geo-spin 0.9s linear infinite;
}

.geo-progress .text {
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  padding: 0 60rpx;
}

@keyframes geo-spin {
  to {
    transform: rotate(360deg);
  }
}

.geo-pager {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.geo-rich {
  font-size: 27rpx;
  line-height: 1.8;
  color: #333;
  word-break: break-all;
}

.geo-rich image {
  max-width: 100%;
}

.geo-divider {
  height: 1rpx;
  margin: 20rpx 0;
  background: #f0f2f5;
}
