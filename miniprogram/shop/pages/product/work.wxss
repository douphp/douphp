/* pages/user/product.wxss */
.product-list {
}
.product-list .item {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 1px solid #eee;
}
.product-list .item .img {
  width: 70px;
}
.product-list .item .img image {
  width: 100%;
}
.product-list .item .info {
  flex: 1;
}
.product-list .item .info .sub {
  font-size: 12px;
  color: #999;
}
.product-list .item .info .price-box {
  margin-top: 5px;
  font-size: 12px;
}
.product-list .item .handle {
  width: 80px;
}
.product-list .item .handle .action {
 display: block;
 background-color: #EEE;
 color: #777;
 text-align: center;
 font-size: 12px;
 padding: 2px 0;
 margin-bottom: 15px;
}