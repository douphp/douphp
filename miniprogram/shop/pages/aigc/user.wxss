/* pages/aigc/user.wxss 我的AI应用 */
.body {
  padding-bottom: 40rpx;
}
.wrap {
  padding: 20rpx 30rpx;
}

.aigc-quota-card {
  background: linear-gradient(135deg, #4a90e2, #357abd);
  border-radius: 16rpx;
  color: #fff;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.aigc-quota-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.aigc-quota-head .name {
  font-size: 32rpx;
  font-weight: bold;
}
.aigc-quota-head .expires {
  font-size: 24rpx;
  opacity: 0.85;
}
.aigc-quota-stats {
  display: flex;
}
.aigc-quota-stats .stat {
  flex: 1;
}
.aigc-quota-stats .label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}
.aigc-quota-stats .value {
  font-size: 34rpx;
  font-weight: bold;
}

.aigc-no-subscription {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 26rpx;
  color: #8c6d1f;
}
.aigc-no-subscription .btn-buy {
  background: #fa8c16;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.aigc-quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.aigc-quick-actions .action {
  flex: 1;
  background: #fff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #4a5a70;
}
.aigc-quick-actions .action text {
  display: block;
  font-size: 36rpx;
  color: #4a90e2;
  margin-bottom: 10rpx;
}

.aigc-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 10rpx 0 20rpx;
}
.aigc-sub-item {
  background: #fff;
  border: 1rpx solid #eef1f6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.aigc-sub-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.aigc-sub-head .name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.aigc-sub-head .status {
  font-size: 22rpx;
  color: #8a94a6;
}
.aigc-sub-head .status.active {
  color: #2e9b4f;
}
.aigc-sub-head .status.expired {
  color: #d9534f;
}
.aigc-sub-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #4a5a70;
  padding: 8rpx 0;
}
.aigc-sub-row .label {
  color: #999;
}
.aigc-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}
